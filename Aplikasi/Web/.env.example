APP_NAME="Payoung"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Produksi (D-20): APP_URL = domain tenant, misal https://dashboard.payoung.id
APP_URL=http://localhost:8000

# Proksi tepercaya (audit PAY-P1-05): kosong = tanpa proksi; `*` = percaya pemanggil langsung (hanya bila server tidak
# bisa dijangkau selain lewat proksi); atau daftar IP/CIDR dipisah koma (rentang Cloudflare: https://www.cloudflare.com/ips/).
PROKSI_TEPERCAYA=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 wajib (juga untuk dev: MySQL Linux via Docker/WSL2, lower_case_table_names=0). PRD §13.7.5
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=PosSaas
DB_USERNAME=pos_saas
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Platform Pengelola (P-01, PRD §13.8). Produksi (D-20): consol.payoung.id
PENGELOLA_DOMAIN=pengelola.localhost
PENGELOLA_COOKIE_SESI=sesi_pengelola

# Pembagian domain (D-20, PRD §14.1). Kosong = pemasaran & tenant di satu host (pengembangan).
# Produksi: DOMAIN_PEMASARAN=payoung.id, DOMAIN_TENANT=dashboard.payoung.id (sama dengan host APP_URL).
DOMAIN_PEMASARAN=
DOMAIN_TENANT=

# Edisi aplikasi (D-35, PRD §13.10): Saas (bawaan) atau Lisensi (dashboard dipasang pembeli di server & domainnya
# sendiri; butuh berkas lisensi dari Payoung, lihat Panduan/InstalasiLisensi.md).
EDISI=Saas
